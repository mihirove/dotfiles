{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9999,
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_TTS_PIPER_MODEL": "/Users/mihiro/.claude/hooks/piper-tts/models/en_US-amy-medium.onnx",
    "CLAUDE_TTS_BACKEND": "piper",
    "KOKORO_SPEED": "1.0"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(~/Documents/**/*.js)",
      "Read(~/Documents/**/*.ts)",
      "Read(~/Documents/**/*.tsx)",
      "Bash(ls:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(bq show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose restart:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git run view:*)",
      "Bash(git show:*)",
      "WebSearch",
      "mcp__notion__fetch",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__get_console_message",
      "mcp__linear__get_issue",
      "mcp__linear__get_project",
      "mcp__linear__get_user",
      "mcp__linear__list_issues",
      "mcp__linear__list_teams",
      "mcp__linear__list_comments",
      "mcp__figma__get_design_context",
      "mcp__figma__get_screenshot"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read f; case \"$f\" in *.js|*.ts|*.tsx|*.jsx|*.json|*.md|*.css|*.html|*.yaml|*.yml) prettierd \"$f\" ;; esac; }"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_VOICE\" = \"1\" ] && ~/.claude/hooks/tts-server-start.sh || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/english-coach.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_VOICE\" = \"1\" ] && ~/.claude/hooks/tts-server-stop.sh || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_VOICE\" = \"1\" ] && python3 ~/.claude/hooks/say-response.py || true",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superwhisper@superwhisper": false
  },
  "extraKnownMarketplaces": {
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    }
  },
  "outputStyle": "default",
  "language": "english",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "registry.npmjs.org"
      ],
      "allowAllUnixSockets": true
    },
    "filesystem": {},
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker"
    ]
  },
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
